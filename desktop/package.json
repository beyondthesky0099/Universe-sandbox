{
  "name": "astrarium-desktop",
  "productName": "Astrarium",
  "version": "0.2.0",
  "description": "Astrarium, the universe sandbox, as a desktop app that uses your full GPU.",
  "author": "beyondthesky0099",
  "license": "UNLICENSED",
  "private": true,
  "repository": { "type": "git", "url": "https://github.com/beyondthesky0099/Universe-sandbox.git" },
  "homepage": "https://beyondthesky0099.github.io/Universe-sandbox/",
  "main": "main.cjs",
  "scripts": {
    "web": "node copy-web.mjs && node build-server.mjs",
    "start": "npm run web && electron .",
    "dist:win": "npm run web && electron-builder --win --x64 --publish never && electron-builder --win --arm64 --publish never",
    "dist:linux": "npm run web && electron-builder --linux dir --publish never"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.1"
  },
  "build": {
    "appId": "io.github.beyondthesky0099.astrarium",
    "productName": "Astrarium",
    "files": ["main.cjs", "server.cjs", "icon.png", "web/**/*"],
    "directories": { "output": "release" },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Astrarium-Setup-${version}-${arch}.${ext}"
    },
    "portable": { "artifactName": "Astrarium-Portable-${version}-${arch}.${ext}" },
    "linux": { "icon": "icon.png", "category": "Education" }
  }
}
